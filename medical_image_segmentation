# ============================================================
# 5. DICE SCORE AND IOU
# ============================================================
def dice_score(actual, predicted):
    intersection = np.sum(actual * predicted)
    return (2 * intersection + 1e-8) / (np.sum(actual) + np.sum(predicted) + 1e-8)

def iou_score(actual, predicted):
    intersection = np.sum(actual * predicted)
    union = np.sum(actual) + np.sum(predicted) - intersection
    return (intersection + 1e-8) / (union + 1e-8)

# ============================================================
# 6. MRI SEGMENTATION FUNCTION
# ============================================================
def segment_image(image, sigma, threshold):
    smoothed = gaussian_filter(image, sigma=sigma)
    return (smoothed > threshold).astype(np.float32)

# ============================================================
# 7. FITNESS FUNCTION
# ============================================================
def fitness_function(position):
    sigma, threshold = position
    scores = []
    for image, mask in zip(X_val, Y_val):
        prediction = segment_image(image, sigma, threshold)
        scores.append(dice_score(mask, prediction))
    return np.mean(scores)

# ============================================================
# 8. CUCKOO SEARCH OPTIMIZATION
# ============================================================
class CuckooSearch:
    def __init__(self, nests=10, iterations=20, discovery_probability=0.25, step_size=0.1):
        self.nests = nests
        self.iterations = iterations
        self.pa = discovery_probability
        self.step_size = step_size

        self.lower = np.array([0.0, 0.05])
        self.upper = np.array([2.0, 0.95])

        self.population = np.random.uniform(self.lower, self.upper, (nests, 2))
        self.fitness = np.array([fitness_function(nest) for nest in self.population])

        best_index = np.argmax(self.fitness)
        self.best_nest = self.population[best_index].copy()
        self.best_fitness = self.fitness[best_index]
        self.history = []

    def levy_flight(self):
        beta = 1.5
        sigma_u = (math.gamma(1 + beta) * np.sin(np.pi * beta / 2) / 
                   (math.gamma((1 + beta) / 2) * beta * 2 ** ((beta - 1) / 2))) ** (1 / beta)
        u = np.random.normal(0, sigma_u, 2)
        v = np.random.normal(0, 1, 2)
        step = u / (np.abs(v) ** (1 / beta) + 1e-8)
        return step

    def optimize(self):
        for iteration in range(self.iterations):
            for i in range(self.nests):
                step = self.levy_flight()
                new_nest = self.population[i] + self.step_size * step * (self.population[i] - self.best_nest)
                new_nest = np.clip(new_nest, self.lower, self.upper)
                new_fitness = fitness_function(new_nest)

                j = random.randint(0, self.nests - 1)
                if new_fitness > self.fitness[j]:
                    self.population[j] = new_nest
                    self.fitness[j] = new_fitness

            abandoned = np.random.random(self.nests) < self.pa
            for i in range(self.nests):
                if abandoned[i]:
                    self.population[i] = np.random.uniform(self.lower, self.upper)
                    self.fitness[i] = fitness_function(self.population[i])

            best_index = np.argmax(self.fitness)
            if self.fitness[best_index] > self.best_fitness:
                self.best_fitness = self.fitness[best_index]
                self.best_nest = self.population[best_index].copy()

            self.history.append(self.best_fitness)
            print(f"Iteration {iteration + 1}/{self.iterations} | Best Dice: {self.best_fitness:.4f}")

        return self.best_nest, self.best_fitness

