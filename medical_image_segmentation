print("Generating synthetic MRI data...")

def generate_synthetic_data(num_slices=100, image_size=128):
    images = []
    masks = []
    for _ in range(num_slices):
        # Create a blank image with a circular brain-like background
        img = np.zeros((image_size, image_size))
        y, x = np.ogrid[:image_size, :image_size]
        center_y, center_x = image_size // 2, image_size // 2
        brain_mask = (x - center_x)**2 + (y - center_y)**2 < (image_size // 2.5)**2
        img[brain_mask] = 0.5
        
        # Add a synthetic tumor mask
        tumor_center_y = center_y + np.random.randint(-15, 15)
        tumor_center_x = center_x + np.random.randint(-15, 15)
        tumor_radius = np.random.randint(10, 25)
        tumor_mask = (x - tumor_center_x)**2 + (y - tumor_center_y)**2 < tumor_radius**2
        
        # Add tumor to the image (brighter intensity)
        img[tumor_mask] = 0.9
        
        # Add gaussian noise and blur
        img = gaussian_filter(img, sigma=1) + np.random.normal(0, 0.05, img.shape)
        img = np.clip(img, 0, 1)
        
        images.append(img.astype(np.float32))
        masks.append(tumor_mask.astype(np.float32))
        
    return np.array(images), np.array(masks)

# Generate simulated datasets
X_all, Y_all = generate_synthetic_data(num_slices=60, image_size=128)

